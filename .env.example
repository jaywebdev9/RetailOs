# Database
DATABASE_URL="postgresql://retail:retail_dev_password@localhost:5432/retail_os?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NODE_ENV="development"
API_PORT=3001
WEB_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# Object Storage (MinIO / S3 / R2)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="retail-os"
S3_REGION="us-east-1"

# Optional
SENTRY_DSN=""

# ── Billing (see docs/BILLING.md)
PLATFORM_ADMIN_EMAIL=you@example.com
BILLING_PAY_INSTRUCTIONS="Send the amount to M-Pesa 07XX XXX XXX (Your Name), then enter the transaction ID."
BILLING_SUPPORT_PHONE=
